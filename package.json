{
  "name": "mica-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.3+sha512.cce0f9de9c5a7c95bef944169cc5dfe8741abfb145078c0d508b868056848a87c81e626246cb60967cbd7fd29a6c062ef73ff840d96b3c86c40ac92cf4a813ee",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm build && tsc --noEmit",
    "test": "pnpm build && tsx --test tests/*.test.ts",
    "test:integration": "pnpm build && node scripts/integration.mjs",
    "test:generated": "pnpm build && node scripts/integration.mjs --generated",
    "check": "pnpm run lint && pnpm run format:check && pnpm run typecheck && pnpm run test && pnpm run test:integration && pnpm run test:package",
    "bench:types": "pnpm run build && node scripts/bench-types.mjs",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test:package": "pnpm run build && node scripts/package-smoke.mjs",
    "test:compatibility": "pnpm run build && node scripts/bench-types.mjs --matrix",
    "test:load": "pnpm run build && node scripts/stress.mjs load",
    "test:recovery": "pnpm run build && node scripts/stress.mjs recovery"
  },
  "devDependencies": {
    "@mica/db": "workspace:*",
    "@mica/cli": "workspace:*",
    "@types/node": "^22.20.4",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "typescript": "^7.0.2",
    "mongodb": "^7.7.0",
    "tsx": "^4.23.15"
  }
}
